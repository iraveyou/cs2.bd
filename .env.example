# ── Database (Supabase) ───────────────────────────────────
# Production: Use Supabase Transaction Pooler (port 6543)
#   1. Supabase Dashboard → Settings → Database → Connection string → URI
#   2. Replace port 5432 with 6543 (for connection pooling on Vercel)
#   3. Add ?sslmode=require at the end
#   Example: postgresql://postgres:PASS@db.xxxx.supabase.co:6543/postgres?sslmode=require
DATABASE_URL=

# ── Auth (NextAuth) ───────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="CS2BD <noreply@cs2bd.com>"

# ── Push Notifications (Web Push) ─────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:support@cs2bd.com"

# ── Steam API ─────────────────────────────────────────────
# Get from: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# ── App URL (SEO / Schema.org) ────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI (Gemini - optional) ────────────────────────────────
GEMINI_API_KEY=
